DATABASE_URL=postgres://lobby:lobby@localhost:5432/lobby
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate with: openssl rand -base64 24  (must be URL-safe: alphanumeric or base64)
POSTGRES_PASSWORD=
# Real Steam Web API key (https://steamcommunity.com/dev/apikey). Omit/empty = OpenID
# login still works; ticket auth (/auth/ticket) will fail.
STEAM_API_KEY=
STEAM_APP_ID=480
# true enables the unauthenticated /auth/test-token dev endpoint. NEVER true in production.
AUTH_DEV_MODE=false
# Seconds a session JWT stays valid.
JWT_TTL_S=86400
# Comma-separated origins allowed to call the API from browsers (the web demo origin).
CORS_ORIGINS=
MATCH_ACCEPT_TIMEOUT_S=30
REPORT_TIMEOUT_S=300
# Local Temporal server address (plaintext — no TLS locally; the cluster worker
# uses in-cluster gRPC, see the Part B plan Step 12).
TEMPORAL_ADDRESS=http://localhost:7233
# Temporal namespace (the auto-setup image creates `default` on first boot).
TEMPORAL_NAMESPACE=default
# Task queue the in-process worker polls.
TEMPORAL_TASK_QUEUE=lobby
# Anti re-pair window after a resolved match (set 0 for instant demo rematches).
LOBBY_PAIR_COOLDOWN_S=300
# mode:type pairs, comma-separated. type = p2p | server
GAME_MODES=ranked_1v1:p2p,server_arena:server
# Absolute URL of the gameserver creator's allocate endpoint (required for server modes).
# With AUTH_DEV_MODE=true and this unset, a built-in mock creator is used.
GAMESERVER_CREATOR_URL=
# Seconds before an unallocated server match is disputed.
GAMESERVER_ALLOC_TIMEOUT_S=60
# Seconds after the server is ready before a missing result is disputed.
GAMESERVER_RESULT_TIMEOUT_S=300
RUST_LOG=info,lobby_server=debug
LOBBY_HOST=0.0.0.0
LOBBY_PORT=8080
# Required for Steam OpenID login (absolute public origin, e.g. https://lobby.example.com).
PUBLIC_URL=
# coturn REST-auth shared secret; MUST equal the value mounted as static-auth-secret
# on the steam-lobby coturn deployment. Unset => /internal/turn-credentials returns 503.
LOBBY_TURN_SECRET=
# Comma-separated TURN URIs returned to clients (default: turn:turn.john2143.com:3478?transport=udp)
LOBBY_TURN_URIS=
