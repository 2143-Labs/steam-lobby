DATABASE_URL=postgres://lobby:lobby@localhost:5432/lobby
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate with: openssl rand -base64 24  (must be URL-safe: alphanumeric or base64)
POSTGRES_PASSWORD=
# Real Steam Web API key (https://steamcommunity.com/dev/apikey). Omit/empty = OpenID
# login still works; ticket auth (/auth/ticket) will fail.
STEAM_API_KEY=
STEAM_APP_ID=480
# true enables the unauthenticated /auth/test-token dev endpoint. NEVER true in production.
AUTH_DEV_MODE=false
# Seconds a session JWT stays valid.
JWT_TTL_S=86400
# Comma-separated origins allowed to call the API from browsers (the web demo origin).
CORS_ORIGINS=
MATCH_ACCEPT_TIMEOUT_S=30
REPORT_TIMEOUT_S=300
RUST_LOG=info,lobby_server=debug
LOBBY_HOST=0.0.0.0
LOBBY_PORT=8080
# Required for Steam OpenID login (absolute public origin, e.g. https://lobby.example.com).
PUBLIC_URL=
